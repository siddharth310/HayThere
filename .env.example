# Postgres database (required in Amplify/prod; local dev can use local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/field_force?schema=public"

# OpenAI — translation (publish) and Whisper (audio answers)
OPENAI_API_KEY="sk-..."

# Optional: require password to open /portal (omit for open portal in dev)
# PORTAL_PASSWORD="your-secret"

# S3 uploads (required for Amplify/prod audio storage)
S3_UPLOAD_BUCKET="your-bucket-name"
S3_UPLOAD_REGION="ap-south-1"

# Optional: Next.js dev — allow HMR when opening the site by LAN IP (comma-separated hostnames)
# ALLOWED_DEV_ORIGINS=192.168.0.231
